APP_NAME="Unified Backend"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Ho_Chi_Minh

# User ID được cấp thêm role super-admin khi chạy AdminSeeder. Để trống nếu chưa chọn.
SUPER_ADMIN_USER_ID=

APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=vi_VN
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=webaccv3
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="${APP_NAME}"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:8000/auth/facebook/callback
FACEBOOK_GRAPH_VERSION=v23.0

SEPAY_WEBHOOK_API_KEY=
SEPAY_TRANSFER_PREFIX=shop
ACCOUNT_KEY=
WEBHOOK_SECRET=
NEXTJS_WEBHOOK_URL=

CARD_PARTNER_URL=https://thesieure.com/chargingws/v2
CARD_PARTNER_ID=
CARD_PARTNER_KEY=
CARD_PARTNER_TIMEOUT=30

RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Passport confidential client dùng nội bộ cho login và refresh.
SSO_PASSWORD_CLIENT_ID=
SSO_PASSWORD_CLIENT_SECRET=
SSO_ADMIN_USER_IDS=

# Danh sách origin frontend, phân tách bằng dấu phẩy.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Bắt buộc phải cấu hình. Middleware /app/* sẽ từ chối mọi request nếu để trống.
APP_API_KEY=
CAROT_APP_KEY=

BROADCAST_CONNECTION=ably
ABLY_KEY=
ABLY_PUBLIC_KEY=
VITE_ABLY_PUBLIC_KEY="${ABLY_PUBLIC_KEY}"

GOLD_ORDER_PENDING_TIMEOUT_MINUTES=10
GOLD_ORDER_REFUND_GRACE_MINUTES=5
GEM_ORDER_PENDING_TIMEOUT_MINUTES=10
GEM_ORDER_REFUND_GRACE_MINUTES=5

VITE_APP_NAME="${APP_NAME}"
